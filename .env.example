APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the longest job timeout (ImportYachtMedia: 900s), or a media
# import still running is handed to a second worker as a duplicate.
DB_QUEUE_RETRY_AFTER=960
REDIS_QUEUE_RETRY_AFTER=960

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Set MAIL_MAILER=brevo with a BREVO_API_KEY to send real email (production).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The node's identity domain — its name in the federation. It carries the
# well-known trust root, the host line of every request signature, and every
# canonical listing URI, so it is permanent in practice: changing it re-mints
# the identity of every listing this node has published. Federation routes
# are refused on any other hostname. Required before the node can federate.
OPENYACHT_DOMAIN=

# Generated once by `php artisan openyacht:install`, which writes it here.
# Not a trust anchor: it lets partners detect that a domain now hosts a
# different installation. Leave empty on a fresh install.
OPENYACHT_NODE_UUID=

# Display name and public website shown to partners in the well-known
# document. The name defaults to APP_NAME.
OPENYACHT_NODE_NAME=
OPENYACHT_WEBSITE=

# Attribution line attached to every listing this node distributes.
OPENYACHT_ATTRIBUTION_TEXT=

# How long a partner may stay unreachable before this node stops presenting
# its copies as current: first marking them stale everywhere (a MUST), then
# withholding them from public output (a SHOULD). The second threshold is
# the only thing that ever drops the listings of an authority that vanishes
# without sending tombstones.
OPENYACHT_STALE_FLAG_DAYS=7
OPENYACHT_STALE_HIDE_DAYS=30

# Data-entry map for listing coordinates: "openstreetmap" (no key needed)
# or "mapbox" (requires OPENYACHT_MAPBOX_TOKEN; falls back to OpenStreetMap
# without one).
OPENYACHT_MAP_PROVIDER=openstreetmap
OPENYACHT_MAPBOX_TOKEN=

# Outbound "content changed" pings for consumers that pre-build public
# output (e.g. a static-site deploy hook). Comma-separated URLs; off when
# empty. The optional secret is sent as X-OpenYacht-Webhook-Secret.
OPENYACHT_CHANGE_NOTIFY_URLS=
OPENYACHT_CHANGE_NOTIFY_SECRET=
OPENYACHT_CHANGE_NOTIFY_COOLDOWN=15
