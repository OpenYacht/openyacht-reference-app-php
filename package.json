{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.28.0",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/ README.md CLAUDE.md CONTRIBUTING.md SECURITY.md .ai/rules/ .github/ docs/api/",
        "format:check": "prettier --check resources/ README.md CLAUDE.md CONTRIBUTING.md SECURITY.md .ai/rules/ .github/ docs/api/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/eslint-config-typescript": "^14.3.0",
        "concurrently": "^10.0.6",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^10.11.1",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.4",
        "vue-tsc": "^3.3.13"
    },
    "dependencies": {
        "@iconify-json/lucide": "^1.2.146",
        "@inertiajs/vite": "^3.9.1",
        "@inertiajs/vue3": "^3.9.1",
        "@laravel/passkeys": "^0.4.0",
        "@nuxt/ui": "^4.12.0",
        "@vueuse/core": "^14.4.0",
        "laravel-vite-plugin": "^3.0.0",
        "leaflet": "^1.9.4",
        "mapbox-gl": "^3.33.0",
        "tailwindcss": "^4.1.1",
        "vue": "^3.5.44",
        "vue-input-otp": "^0.4.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.5",
        "@rollup/rollup-linux-x64-gnu": "4.64.10",
        "@rollup/rollup-win32-x64-msvc": "4.64.11",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
